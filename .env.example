# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Configuration (single-node replica set in dev, Atlas in prod)
MONGO_URI=mongodb://localhost:27017/chat?replicaSet=rs0&directConnection=true

# Redis Configuration (Socket.IO adapter, presence, BullMQ)
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_second_secure_random_string_at_least_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS & Gateway Allowlist
CLIENT_URL=http://localhost:5173

# Process Role: 'api', 'gateway', or 'all'
PROCESS_ROLE=all

# Web Push (VAPID) Credentials
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=zena-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Presence Sweep Interval (ms)
PRESENCE_RECONCILE_INTERVAL_MS=60000
