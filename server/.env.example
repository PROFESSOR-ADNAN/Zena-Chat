PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/chat
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Socket.IO CORS — the origin your frontend will actually run on
CLIENT_URL=http://localhost:5173

# Required from this phase on — the Redis adapter (cross-instance
# broadcast) and presence tracking both depend on it
REDIS_URL=redis://localhost:6379

# Optional: how often (ms) to sweep Redis for stale presence entries left
# by a crashed instance. Default 60000. Raise it on a metered Redis plan
# — every sweep costs commands.
# PRESENCE_RECONCILE_INTERVAL_MS=60000
